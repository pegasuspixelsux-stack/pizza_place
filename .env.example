# Copy this file to .env.local for local development, or add these as
# Environment Variables in your Vercel project settings for deployment.

# --- Admin authentication (required) ------------------------------------
# Username for the /admin dashboard.
ADMIN_USERNAME=admin

# Bcrypt hash of the admin password. Generate one with:
#   npm run hash-password -- "your-password-here"
ADMIN_PASSWORD_HASH=

# Secret used to sign admin session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=

# --- Persistent storage (required in production on Vercel) --------------
# Without this, admin edits (menu, hero, footer) are written to
# data/menu.json on disk, which works great locally but does NOT persist
# on Vercel's read-only, ephemeral filesystem. Create a Blob store from the
# Vercel dashboard (Storage tab) or run `vercel integration add blob`, then
# `vercel env pull` to bring the token into your local environment.
BLOB_READ_WRITE_TOKEN=
